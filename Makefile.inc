
#-------------------------------------------------------
# Select quantization configuration                    |
#-------------------------------------------------------
#+================+========================================+======================================+
#| COMPILE OPTION |              DATA TYPES                |               DESCRIPTION            |
#+================+========================================+======================================+
#|  NQ_FP32       | Input:FP32  + Pack:FP32  + Micro:FP32  | No quantization with FP32.           |
#|  NQ_FP16       | Input:FP16  + Pack:FP16  + Micro:FP16  | No quantization with FP16.           |
#|  Q_INT8_INT32  | Input:INT8  + Pack:INT8  + Micro:INT32 | NOT AVAILABLE.                       |
#+----------------+----------------------------------------+--------------------------------------+
#|                | Input:INT8  + Pack:INT32 + Micro:INT32 | Fake quantization. Casting to INT32. |
#|  FQ_INT8_INT32 | WARNING: RVV0.7 without support for    | WARNING: This configuration is only  |
#|                | quantization                           | available for C910 and C906.         |
#+================+========================================+======================================+
#-------------------------------------------------------
QTYPE=NQ_FP32
#-------------------------------------------------------


#-------------------------------------------------------
# Select Processor Architecture Configuration          |
#-------------------------------------------------------
#+===========+=============+==================+
#| PROCESSOR |     SIMD    |   DESCRIPTION    |
#+===========+=============+==================+
#|   C906    |  RISCVv0.7  |  -               |
#|   C910    |  RISCVv0.7  |  -               |
#|   C908    |  RISCVV1.0  |  K230            |
#|   K1      |  RISCVv1.0  |  Banana Pi       |
#+===========+=============+==================+
#-------------------------------------------------------
PROCESSOR=K1
#-------------------------------------------------------


#-------------------------------------------------------
# IME ENABLED                                          |
#-------------------------------------------------------
# [*] NONE
# [*] IME_ENABLE
#-------------------------------------------------------
IME=NONE
#-------------------------------------------------------


#-------------------------------------------------------
# LINEAL LIBRARIES SELECCTION                          |
#-------------------------------------------------------
# [*] OPENBLAS_ON
# [*] BLIS_ON
# [*] GEMMLIB_ON
#-------------------------------------------------------
LINEAL_SELECT=GEMMLIB_ON
#-------------------------------------------------------
OPENBLAS_PATH=/home/martineh/software/OpenBLAS/install/
BLIS_PATH=/home/martineh/software/blis/install

