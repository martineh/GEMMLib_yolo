void prepack_B( char orderB, size_t n, size_t k, IN_TYPE *B, size_t ldB, PACK_TYPE *Bc, size_t NC, size_t KC, int NR) {

  int jc, pc, nc, kc, kc_pack, nc_pack;
  IN_TYPE *Bptr;

  if ((n==0) || (k==0)) return;

  for ( jc=0; jc<n; jc+=NC ) {
    nc = min(n-jc, NC);
    nc_pack = (int)ceil((double)nc / (double)NR) * NR;

    for ( pc=0; pc<k; pc+=KC) {
      kc = min(k-pc, KC);
      kc_pack = (int)ceil((double)kc / 16.0) * 16;

      if (orderB == 'C') Bptr = &Bcol(pc,jc);
      else               Bptr = &Brow(pc,jc);

      PACK_B(orderB, 'N', kc, nc, Bptr, ldB, Bc, NR);
      Bc += nc_pack * kc_pack;

    }

  }

}

