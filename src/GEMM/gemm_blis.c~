{ \
  if (mr == MR && nr == NR) \
    uk(mr, nr, kc, A, B, C, beta, ldA, ldB, ldC); \
  else { \
    uk(mr, nr, kc, A, B, Ctmp_th, 0, ldA, ldB, MR);\
