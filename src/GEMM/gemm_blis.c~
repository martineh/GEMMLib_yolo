#define PK_MR YOLO_MR   /* 16, debe coincidir con la GEMM */
#define PK_KC YOLO_KC   /* 512, debe coincidir con la GEMM */

static inline int64_t ceil_div64(int64_t a, int64_t b) { return (a + b - 1) / b; }

/* Escribe len ceros en las posiciones virtuales p..p+len-1 de una fila k */
static inline void pk_zero(float *base, size_t ps, int64_t p, int64_t len) {
    while (len > 0) {
        int64_t po = p % PK_MR;
        int64_t n  = PK_MR - po; if (n > len) n = len;
        memset(base + (size_t)(p / PK_MR) * ps + po, 0, sizeof(float) * n);
        p += n; len -= n;
    }
}

/* Copia contigua (dW == 1) */
static inline void pk_copy(float *base, size_t ps, int64_t p, const float *s, int64_t len) {
    while (len > 0) {
        int64_t po = p % PK_MR;
        int64_t n  = PK_MR - po; if (n > len) n = len;
        memcpy(base + (size_t)(p / PK_MR) * ps + po, s, sizeof(float) * n);
        p += n; s += n; len -= n;
    }
}


typedef struct { int32_t y, xs, len, lane; } seg_t;

void _im2col_pack_rvv(const float* input_data, float* apack,
                      int64_t kH, int64_t kW, int64_t dH, int64_t dW,
                      int64_t padH, int64_t padW,
                      int64_t n_input_plane, int64_t input_height, int64_t input_width,
                      int64_t output_height, int64_t output_width) {

    const int64_t M     = output_height * output_width;
    const int64_t K     = n_input_plane * kH * kW;
    const int64_t npan  = ceil_div64(M, PK_MR);
    const size_t  M_pad = (size_t)npan * PK_MR;
    const int64_t nkb   = ceil_div64(K, PK_KC);
    const int64_t khw   = kH * kW;

    #pragma omp parallel for collapse(2) schedule(static)
    for (int64_t kb = 0; kb < nkb; kb++) {
        for (int64_t ib = 0; ib < npan; ib++) {

            const int64_t pc = kb * PK_KC;
            const int64_t kc = (K - pc < PK_KC) ? (K - pc) : PK_KC;
            const int64_t p0 = ib * PK_MR;
            const int nvalid = (int)((M - p0 < PK_MR) ? (M - p0) : PK_MR);

            /* Segmentos del panel: tramos de píxeles dentro de la misma fila y.
               No dependen de k, se calculan una vez por panel. */
            seg_t seg[PK_MR];
            int ns = 0;
            {
                int64_t p = p0; int left = nvalid, lane = 0;
                while (left > 0) {
                    int64_t y = p / output_width, x = p % output_width;
                    int len = (int)(output_width - x); if (len > left) len = left;
                    seg[ns].y = (int32_t)y; seg[ns].xs = (int32_t)x;
                    seg[ns].len = len;      seg[ns].lane = lane;
                    ns++; p += len; left -= len; lane += len;
                }
            }

            float *dst = apack + (size_t)pc * M_pad + (size_t)ib * PK_MR * kc;

            /* Estado (nip, kh, kw) de la primera fila k = pc; luego se incrementa */
            int64_t nip  = pc / khw;
            int64_t rest = pc % khw;
            int64_t kh   = rest / kW;
            int64_t kw   = rest % kW;

            for (int64_t kk = 0; kk < kc; kk++, dst += PK_MR) {
                const float *src = input_data + (size_t)nip * input_height * input_width;

                if (nvalid < PK_MR) {               /* panel de cola: lanes sobrantes a 0 */
                    size_t vl = __riscv_vsetvl_e32m2(PK_MR);
                    __riscv_vse32_v_f32m2(dst, __riscv_vfmv_v_f_f32m2(0.0f, vl), vl);
                }

                for (int s = 0; s < ns; s++) {
                    const int len = seg[s].len;
                    float *d = dst + seg[s].lane;
                    const int64_t iy = (int64_t)seg[s].y * dH - padH + kh;
                    size_t vl = __riscv_vsetvl_e32m2(len);

                    if (iy < 0 || iy >= input_height) {
                        __riscv_vse32_v_f32m2(d, __riscv_vfmv_v_f_f32m2(0.0f, vl), vl);
                        continue;
                    }

                    const float  *row = src + (size_t)iy * input_width;
                    const int64_t ix0 = (int64_t)seg[s].xs * dW - padW + kw;
                    const int64_t ixl = ix0 + (int64_t)(len - 1) * dW;

                    if (ix0 >= 0 && ixl < input_width) {          /* camino rápido */
                        vfloat32m2_t v = (dW == 1)
                            ? __riscv_vle32_v_f32m2(row + ix0, vl)
                            : __riscv_vlse32_v_f32m2(row + ix0,
                                                     (ptrdiff_t)(dW * sizeof(float)), vl);
                        __riscv_vse32_v_f32m2(d, v, vl);
                    } else {                                       /* borde: escalar */
                        for (int j = 0; j < len; j++) {
                            int64_t ix = ix0 + (int64_t)j * dW;
                            d[j] = (ix < 0 || ix >= input_width) ? 0.0f : row[ix];
                        }
                    }
                }

                /* siguiente k = (nip, kh, kw) */
                if (++kw == kW) { kw = 0; if (++kh == kH) { kh = 0; nip++; } }
            }
        }
    }

    pack_ready = 0;
    ref_im2col = NULL;
}



void _im2col_rvv(const float* input_data, float* finput_data,
                 int64_t kH, int64_t kW, int64_t dH, int64_t dW, int64_t padH, int64_t padW,
                 int64_t n_input_plane, int64_t input_height, int64_t input_width,
                 int64_t output_height, int64_t output_width) {

    #pragma omp parallel for
    for (int64_t k = 0; k < n_input_plane * kH * kW; k++) {
        int64_t nip  = k / (kH * kW);
        int64_t rest = k % (kH * kW);
        int64_t kh   = rest / kW;
        int64_t kw   = rest % kW;

        float *dst = finput_data
                   + nip * ((size_t)kH * kW * output_height * output_width)
                   + kh  * ((size_t)kW * output_height * output_width)
                   + kw  * ((size_t)output_height * output_width);

        const float *src = input_data + nip * ((size_t)input_height * input_width);

        if (padW > 0 || padH > 0) {
            for (int64_t y = 0; y < output_height; y++) {
                int64_t iy = y * dH - padH + kh;

                if (iy < 0 || iy >= input_height) {
                    memset(dst + (size_t)y * output_width, 0,
                           sizeof(float) * output_width);
                } else if (dW == 1) {
                    int64_t ix   = 0 - padW + kw;
                    int64_t lpad = max64(0, padW - kw);
                    int64_t rpad = max64(0, padW - (kW - kw - 1));

                    if (output_width - rpad - lpad <= 0) {
                        memset(dst + (size_t)y * output_width, 0,
                               sizeof(float) * output_width);
                    } else {
                        if (lpad > 0)
                            memset(dst + (size_t)y * output_width, 0,
                                   sizeof(float) * lpad);
                        memcpy(dst + (size_t)y * output_width + lpad,
                               src + (size_t)iy * input_width + ix + lpad,
                               sizeof(float) * (output_width - rpad - lpad));
                        if (rpad > 0)
                            memset(dst + (size_t)y * output_width + output_width - rpad, 0,
                                   sizeof(float) * rpad);
                    }
                } else {
                    for (int64_t x = 0; x < output_width; x++) {
                        int64_t ix = x * dW - padW + kw;
                        if (ix < 0 || ix >= input_width)
                            dst[(size_t)y * output_width + x] = 0.0f;
                        else
                            dst[(size_t)y * output_width + x] =
                                src[(size_t)iy * input_width + ix];
                    }
                }
            }
        } else {
            for (int64_t y = 0; y < output_height; y++) {
                int64_t iy = y * dH + kh;
                int64_t ix = 0 + kw;

                if (dW == 1) {
                    memcpy(dst + (size_t)y * output_width,
                           src + (size_t)iy * input_width + ix,
                           sizeof(float) * output_width);
                } else {
                    for (int64_t x = 0; x < output_width; x++)
                        dst[(size_t)y * output_width + x] =
                            src[(size_t)iy * input_width + ix + x * dW];
                }
            }
        }
    }
}


static inline int64_t i2c_cdiv(int64_t a, int64_t b) { return (a + b - 1) / b; }

void _im2col_rvv_fp16(const float *input_data, fp16_t *finput_data,
                      int64_t kH, int64_t kW, int64_t dH, int64_t dW,
                      int64_t padH, int64_t padW,
                      int64_t n_input_plane, int64_t input_height, int64_t input_width,
                      int64_t output_height, int64_t output_width)
{
    const int64_t OW = output_width;

    #pragma omp parallel for
    for (int64_t k = 0; k < n_input_plane * kH * kW; k++) {
        const int64_t nip  = k / (kH * kW);
        const int64_t rest = k % (kH * kW);
        const int64_t kh   = rest / kW;
        const int64_t kw   = rest % kW;

        fp16_t *dst = finput_data + (size_t)k * output_height * OW;
        const float *src = input_data + (size_t)nip * input_height * input_width;

        /* x validos: ix = x*dW - padW + kw dentro de [0, input_width) (con pad = 0 sale [0, OW)) */
        int64_t lo  = (padW > kw) ? i2c_cdiv(padW - kw, dW) : 0;
        int64_t num = input_width + padW - kw;
        int64_t hi  = (num > 0) ? i2c_cdiv(num, dW) : 0;
        if (hi > OW) hi = OW;
        if (lo > hi) lo = hi;

        for (int64_t y = 0; y < output_height; y++) {
            fp16_t *d = dst + (size_t)y * OW;
            const int64_t iy = y * dH - padH + kh;

            if (iy < 0 || iy >= input_height || lo >= hi) {
                memset(d, 0, sizeof(fp16_t) * OW);      /* +0.0 en fp16 = bits a cero */
                continue;
            }
            const float *row = src + (size_t)iy * input_width + (lo * dW - padW + kw);

            if (lo > 0) memset(d, 0, sizeof(fp16_t) * lo);
            for (int64_t x = lo, j = 0; x < hi; x++, j += dW) d[x] = (fp16_t)row[j];
            if (hi < OW) memset(d + hi, 0, sizeof(fp16_t) * (OW - hi));
        }
    }
}


void _im2col_pack_rvv_fp16(const float *input_data, fp16_t *apack,
                           int64_t kH, int64_t kW, int64_t dH, int64_t dW,
                           int64_t padH, int64_t padW,
                           int64_t n_input_plane, int64_t input_height, int64_t input_width,
                           int64_t output_height, int64_t output_width)
{
    const int64_t M     = output_height * output_width;
    const int64_t K     = n_input_plane * kH * kW;
    const int64_t npan  = i2c_cdiv(M, PK_MR);
    const size_t  M_pad = (size_t)npan * PK_MR;
    const int64_t nkb   = i2c_cdiv(K, PK_KC);
    const int64_t khw   = kH * kW;

    /* Cada tarea (bloque de k, panel de 16 pixeles) rellena un trozo contiguo de 16*kc elementos */
    #pragma omp parallel for collapse(2) schedule(static)
    for (int64_t kb = 0; kb < nkb; kb++) {
        for (int64_t ib = 0; ib < npan; ib++) {

            const int64_t pc = kb * PK_KC;
            const int64_t kc = (K - pc < PK_KC) ? (K - pc) : PK_KC;
            const int64_t p0 = ib * PK_MR;
            const int nvalid = (int)((M - p0 < PK_MR) ? (M - p0) : PK_MR);

            /* Tramos del panel dentro de una misma fila y de salida; no dependen de k */
            seg_t seg[PK_MR];
            int ns = 0;
            {
                int64_t p = p0; int left = nvalid, lane = 0;
                while (left > 0) {
                    const int64_t y = p / output_width, x = p % output_width;
                    int len = (int)(output_width - x); if (len > left) len = left;
                    seg[ns].y = (int32_t)y; seg[ns].xs = (int32_t)x;
                    seg[ns].len = len;      seg[ns].lane = lane;
                    ns++; p += len; left -= len; lane += len;
                }
            }

            fp16_t *dst = apack + (size_t)pc * M_pad + (size_t)ib * PK_MR * kc;

            /* (nip, kh, kw) de la fila k = pc; despues se incrementa */
            int64_t nip  = pc / khw;
            int64_t rest = pc % khw;
            int64_t kh   = rest / kW;
            int64_t kw   = rest % kW;

            for (int64_t kk = 0; kk < kc; kk++, dst += PK_MR) {
                const float *src = input_data + (size_t)nip * input_height * input_width;

                if (nvalid < PK_MR) memset(dst, 0, sizeof(fp16_t) * PK_MR);   /* panel de cola */

                for (int s = 0; s < ns; s++) {
                    const int len = seg[s].len;
                    fp16_t *d = dst + seg[s].lane;
                    const int64_t iy = (int64_t)seg[s].y * dH - padH + kh;

                    if (iy < 0 || iy >= input_height) {
                        memset(d, 0, sizeof(fp16_t) * len);
                        continue;
                    }
                    const float  *row = src + (size_t)iy * input_width;
                    const int64_t ix0 = (int64_t)seg[s].xs * dW - padW + kw;
                    const int64_t ixl = ix0 + (int64_t)(len - 1) * dW;

                    if (ix0 >= 0 && ixl < input_width) {                 /* camino habitual */
                        for (int j = 0; j < len; j++) d[j] = (fp16_t)row[ix0 + (int64_t)j * dW];
                    } else {                                              /* bordes */
                        for (int j = 0; j < len; j++) {
                            const int64_t ix = ix0 + (int64_t)j * dW;
                            d[j] = (ix < 0 || ix >= input_width) ? (fp16_t)0 : (fp16_t)row[ix];
                        }
                    }
                }

                /* siguiente k = (nip, kh, kw) */
                if (++kw == kW) { kw = 0; if (++kh == kH) { kh = 0; nip++; } }
            }
        }
    }

    pack_ready = 0;
    ref_im2col = NULL;
}

void silu_kernel_rvv(const float* input, float* output, size_t n) {
    const size_t BLOCK = 4096;          // 16 KB por bloque (múltiplo de 64 B)
    const size_t MIN_PARALLEL = 16384;  // por debajo, se ejecuta en un solo hilo

    const float LOG2E = 1.44269504f;
    const float LN2   = 0.69314718f;
    const float C5 = 1.0f / 120.0f;
    const float C4 = 1.0f / 24.0f;
    const float C3 = 1.0f / 6.0f;
    const float C2 = 0.5f;

    const long nblocks = (long)((n + BLOCK - 1) / BLOCK);

    #pragma omp parallel for schedule(static) if(n >= MIN_PARALLEL)
    for (long b = 0; b < nblocks; ++b) {
        size_t start = (size_t)b * BLOCK;
        size_t len   = min(BLOCK, n - start);

        const float* in  = input  + start;
        float*       out = output + start;

        while (len > 0) {
            size_t vl = __riscv_vsetvl_e32m2(len);
            vfloat32m2_t x = __riscv_vle32_v_f32m2(in, vl);

            // y = clamp(-x, -80, 80)
            vfloat32m2_t y = __riscv_vfneg_v_f32m2(x, vl);
            y = __riscv_vfmax_vf_f32m2(y, -80.0f, vl);
            y = __riscv_vfmin_vf_f32m2(y,  80.0f, vl);

            // k = round(y*log2e); r = y - k*ln2
            vint32m2_t   k  = __riscv_vfcvt_x_f_v_i32m2(__riscv_vfmul_vf_f32m2(y, LOG2E, vl), vl);
            vfloat32m2_t kf = __riscv_vfcvt_f_x_v_f32m2(k, vl);
            vfloat32m2_t r  = __riscv_vfnmsac_vf_f32m2(y, LN2, kf, vl);

            // exp(r) ≈ ((((C5 r + C4) r + C3) r + C2) r + 1) r + 1
            vfloat32m2_t p = __riscv_vfmv_v_f_f32m2(C5, vl);
            p = __riscv_vfmadd_vv_f32m2(p, r, __riscv_vfmv_v_f_f32m2(C4, vl), vl);
            p = __riscv_vfmadd_vv_f32m2(p, r, __riscv_vfmv_v_f_f32m2(C3, vl), vl);
            p = __riscv_vfmadd_vv_f32m2(p, r, __riscv_vfmv_v_f_f32m2(C2, vl), vl);
            p = __riscv_vfmadd_vv_f32m2(p, r, __riscv_vfmv_v_f_f32m2(1.0f, vl), vl);
            p = __riscv_vfmadd_vv_f32m2(p, r, __riscv_vfmv_v_f_f32m2(1.0f, vl), vl);

            // exp(-x) = p * 2^k
            vint32m2_t   bits = __riscv_vsll_vx_i32m2(__riscv_vadd_vx_i32m2(k, 127, vl), 23, vl);
            vfloat32m2_t e = __riscv_vfmul_vv_f32m2(p, __riscv_vreinterpret_v_i32m2_f32m2(bits), vl);

            // d = 1 + exp(-x)
            vfloat32m2_t d = __riscv_vfadd_vf_f32m2(e, 1.0f, vl);

            // 1/d con vfrec7 + 2 iteraciones de Newton: rcp = rcp * (2 - d*rcp)
            vfloat32m2_t rcp = __riscv_vfrec7_v_f32m2(d, vl);
            vfloat32m2_t t = __riscv_vfmv_v_f_f32m2(2.0f, vl);
            t   = __riscv_vfnmsac_vv_f32m2(t, d, rcp, vl);
            rcp = __riscv_vfmul_vv_f32m2(rcp, t, vl);
            t = __riscv_vfmv_v_f_f32m2(2.0f, vl);
            t   = __riscv_vfnmsac_vv_f32m2(t, d, rcp, vl);
            rcp = __riscv_vfmul_vv_f32m2(rcp, t, vl);

            // silu = x * (1/d)
            __riscv_vse32_v_f32m2(out, __riscv_vfmul_vv_f32m2(x, rcp, vl), vl);

            in  += vl;
            out += vl;
            len -= vl;
        }
    }
}


typedef void (*pack_intrinsic_fp32) (char orderM, char transM, int mc, int nc, IN_TYPE *M, int ldM, PACK_TYPE *Mc, int RR );


void gemv_rvv_fp32(int m, int k,
                   const IN_TYPE *A, int lda,
                   const IN_TYPE *B,
                   OUT_TYPE beta,
                   OUT_TYPE *C, int ldc)
{
    #pragma omp parallel
    {
        int th_id  = omp_get_thread_num();
        int th_num = omp_get_num_threads();

        int rows_per_thread = (m + th_num - 1) / th_num;

        int start = th_id * rows_per_thread;
        int end   = start + rows_per_thread;

        if (end > m)   end = m;

	if (0 && k == 9) {
          for (int i = start; i < end; )
          {
              size_t vl = __riscv_vsetvl_e32m2(end - i);
  
              vfloat32m2_t acc;
  
              if (beta == 0.0f)
                  acc = __riscv_vfmv_v_f_f32m2(0.0f, vl);
              else
                  acc = __riscv_vle32_v_f32m2(&C[i], vl);
  
              vfloat32m2_t a0 = __riscv_vle32_v_f32m2(&A[i + 0 * lda], vl);
              vfloat32m2_t a1 = __riscv_vle32_v_f32m2(&A[i + 1 * lda], vl);
              vfloat32m2_t a2 = __riscv_vle32_v_f32m2(&A[i + 2 * lda], vl);
              vfloat32m2_t a3 = __riscv_vle32_v_f32m2(&A[i + 3 * lda], vl);
              vfloat32m2_t a4 = __riscv_vle32_v_f32m2(&A[i + 4 * lda], vl);
              vfloat32m2_t a5 = __riscv_vle32_v_f32m2(&A[i + 5 * lda], vl);
              vfloat32m2_t a6 = __riscv_vle32_v_f32m2(&A[i + 6 * lda], vl);
              vfloat32m2_t a7 = __riscv_vle32_v_f32m2(&A[i + 7 * lda], vl);
              vfloat32m2_t a8 = __riscv_vle32_v_f32m2(&A[i + 8 * lda], vl);
  
              acc = __riscv_vfmacc_vf_f32m2(acc, B[0], a0, vl);
              acc = __riscv_vfmacc_vf_f32m2(acc, B[1], a1, vl);
              acc = __riscv_vfmacc_vf_f32m2(acc, B[2], a2, vl);
              acc = __riscv_vfmacc_vf_f32m2(acc, B[3], a3, vl);
              acc = __riscv_vfmacc_vf_f32m2(acc, B[4], a4, vl);
              acc = __riscv_vfmacc_vf_f32m2(acc, B[5], a5, vl);
              acc = __riscv_vfmacc_vf_f32m2(acc, B[6], a6, vl);
              acc = __riscv_vfmacc_vf_f32m2(acc, B[7], a7, vl);
              acc = __riscv_vfmacc_vf_f32m2(acc, B[8], a8, vl);
  
              __riscv_vse32_v_f32m2(&C[i], acc, vl);
  
              i += vl;
          }
	
	} else {

          for (int i = start; i < end; )
          {
              size_t vl = __riscv_vsetvl_e32m8(end - i);
  
              vfloat32m8_t acc;
  
              if (beta == 0.0f)
                  acc = __riscv_vfmv_v_f_f32m8(0.0f, vl);
              else
                  acc = __riscv_vle32_v_f32m8(&C[i], vl);
  
              for (int p = 0; p < k; ++p)
              {
                  vfloat32m8_t a =
                      __riscv_vle32_v_f32m8(&A[i + p * lda], vl);
  
                  acc = __riscv_vfmacc_vf_f32m8(
                      acc, B[p], a, vl);
              }
  
              __riscv_vse32_v_f32m8(&C[i], acc, vl);
  
              i += vl;
          }
      }
   }
}

void gemm_rvv(char *transa, char *transb, int *m, int *n, int *k, OUT_TYPE *alpha, const IN_TYPE *a, int *lda, const IN_TYPE *b, int *ldb, OUT_TYPE *beta, OUT_TYPE *c, int *ldc) {

   #ifdef OPENBLAS_ON

   int m_ = *m, n_ = *n, k_ = *k, lda_ = *lda, ldb_ = *ldb, ldc_ = *ldc;
   float alpha_ = *alpha, beta_ = *beta;

   //openblas_set_num_threads(8);

   cblas_sgemm(CblasColMajor,
      to_cblas_transpose(transa), 
      to_cblas_transpose(transb),
      m_, n_, k_,
      alpha_,
      a, lda_,
      b, ldb_,
      beta_,
      c, ldc_);

   //openblas_set_num_threads(1); 
   
   return;
   #endif
   
   #ifdef BLIS_ON
   
   sgemm_(transa, transb,
          m, n, k,
          alpha,
          a, lda,
          b, ldb,
          beta,
          c, ldc);

     return;
   #endif


  // Quick return if possible
  if ( (*m==0)||(*n==0)||(((*alpha==0.0)||(*k==0))&&(*beta==1.0)) ) return;

  int loop;

  //----------------------------------------------------------
  // GEMM CALL
  //----------------------------------------------------------
  char orderA  = 'C';
  char orderB  = 'C';
  char orderC  = 'C';
  char transA  = *transa;
  char transB  = *transb;
  char prepack = 0;
  
  if (!Ac) {
    Ac   = (PACK_TYPE *)malloc(BUFFER_SIZE * sizeof(PACK_TYPE));
    Ctmp = (OUT_TYPE  *)malloc(262144      * sizeof(OUT_TYPE));
    #pragma omp parallel
    { TH = omp_get_num_threads(); }
  }

  Bc = Ac + (*m) * (*k) * 2;


  if (pack_ready) {
      const int use_prepack = (ref_im2col == a && transA == 'N' && transB == 'N' && *n > 1);
    
      pack_ready = 0; 
      ref_im2col = NULL;

      if (use_prepack) {
        IM2COL_PACK (im2col_data.input_data, _im2col, 
		     im2col_data.kH, im2col_data.kW, im2col_data.dH, im2col_data.dW, 
		     im2col_data.padH, im2col_data.padW, im2col_data.n_input_plane, 
		     im2col_data.input_height, im2col_data.input_width, 
		     im2col_data.output_height, im2col_data.output_width);
  
        gemm_prepack_B3A2C0( orderA, orderB, orderC, transA, transB, *m, *n, *k, *alpha, _im2col, *lda, b, *ldb, *beta, 
		             c, *ldc, Ac, Bc, LOOP_IR, Ctmp, prepack);
  
        return;
  
      }
  
      IM2COL(im2col_data.input_data, im2col_data.finput_data, 
             im2col_data.kH, im2col_data.kW, im2col_data.dH, im2col_data.dW, 
             im2col_data.padH, im2col_data.padW, im2col_data.n_input_plane, 
             im2col_data.input_height, im2col_data.input_width, 
             im2col_data.output_height, im2col_data.output_width);
      
  }
      
  if (*n == 1) gemv_rvv_fp32(*m, *k, a, *lda, b, *beta, c, *ldc);
  else         gemm_B3A2C0( orderA, orderB, orderC, transA, transB, *m, *n, *k, *alpha, a, *lda, b, *ldb, *beta, 
  		                c, *ldc, Ac, Bc, LOOP_IR, Ctmp, prepack);

  return;

}



void gemm_B3A2C0( char orderA, char orderB, char orderC, char transA, char transB, 
                  int m, int n, int k, OUT_TYPE alpha, 
	          const IN_TYPE *A, int ldA, const IN_TYPE *B, int ldB, 
		  OUT_TYPE beta,  OUT_TYPE *C, int ldC, 
		  PACK_TYPE *Ac, PACK_TYPE *Bc, 
		  int loop, OUT_TYPE *Ctmp, char prepack) {

  int ic, jc, pc, mc, nc, kc, ir, jr, mr, nr, j, i, kc_chunk, kc_packA, kc_packB, mc_pack;
  size_t jr_lim, ir_lim;
  
  OUT_TYPE one = 1, betaI; 
  const IN_TYPE *Bptr, *Aptr;
  OUT_TYPE *Cptr;
  OUT_TYPE *Ctmp_th;
  
  size_t jr_init, jr_limit, ir_init, ir_limit;
  int th_id, th_num;

  int NC = n;
  int MC = YOLO_MC;
  int KC = YOLO_KC;

  int MR, NR;
  pack_intrinsic_fp32 pack;

  #ifdef NQ_FP32
    uk_intrinsic_fp32 uk;
    if (n==4) {MR=YOLO_MR; NR=4;       uk = ukernel_16x4_fp32;}
    else      {MR=YOLO_MR; NR=YOLO_NR; uk = ukernel_16x8_fp32;}
  #else
    uk_intrinsic_fp16 uk;
    if (n==4) {MR=YOLO_MR; NR=4;       uk = ukernel_16x4_fp16;}
    else      {MR=YOLO_MR; NR=YOLO_NR; uk = ukernel_16x8_fp16;}
  #endif
  
  //MR=YOLO_MR; NR=4;       uk = ukernel_16x4_fp32;

  if (transA == 'T') pack = PACK_A;
  else               pack = pack_generic_MRxkc_A;

  const size_t M_pad = ((size_t)m + MR - 1) / MR * MR;
  
  #pragma omp parallel private(jr_init, jr_limit, ir_init, ir_limit, jc, nc, pc, kc, Aptr, Bptr, ic, mc, Cptr, \
                               Ctmp_th, jr, nr, ir, mr, th_id, th_num, betaI, kc_chunk, kc_packA, kc_packB, mc_pack)
  {

  th_id   = omp_get_thread_num();
  th_num  = omp_get_num_threads();
  Ctmp_th = &Ctmp[th_id * MR * NR];
  
  for ( jc=0; jc<n; jc+=NC ) {
    nc = min(n-jc, NC); 
    int its_nc = (int) ceil((double)nc/NR/th_num);

    if (loop == LOOP_JR) { jr_limit = min(nc,(th_id+1)*(its_nc*NR)); jr_init = th_id*(its_nc*NR); }
    else { jr_limit = nc; jr_init = 0;}

    for ( pc=0; pc<k; pc+=KC ) {
      kc = min(k-pc, KC); 

      if      ( (transB=='N')&&(orderB=='C') ) Bptr = &Bcol(pc, jc + its_nc * NR * th_id);
      else if ( (transB=='N')&&(orderB=='R') ) Bptr = &Brow(pc, jc + its_nc * NR * th_id);
      else if ( (transB=='T')&&(orderB=='C') ) Bptr = &Bcol(jc + its_nc * NR * th_id, pc);
      else                                     Bptr = &Brow(jc + its_nc * NR * th_id, pc);

      PACK_B( orderB, transB, kc, min(its_nc * NR, nc - its_nc * NR * th_id), 
              Bptr, ldB, Bc + kc * its_nc * NR * th_id, NR);

      if ( pc==0 ) betaI = beta;
      else betaI = one;

      #pragma omp barrier 

      for ( ic=0; ic<m; ic+=MC ) {
        mc = min(m-ic, MC); 
	mc_pack = (int)ceil((double)mc / (double)MR) * MR;
	int its_mc = (int) ceil((double)mc/MR/omp_get_num_threads());
	
	if (loop == LOOP_IR) { ir_limit = min(mc,(th_id+1)*(its_mc*MR)); ir_init = th_id*(its_mc*MR); }
	else { ir_limit = mc; ir_init = 0;}

	const PACK_TYPE *Ablk;

        if      ( (transA=='N')&&(orderA=='C') ) Aptr = &Acol(ic + its_mc * MR * th_id, pc);
        else if ( (transA=='N')&&(orderA=='R') ) Aptr = &Arow(ic + its_mc * MR * th_id, pc);
        else if ( (transA=='T')&&(orderA=='C') ) Aptr = &Acol(pc, ic + its_mc * MR * th_id);
        else                                     Aptr = &Arow(pc, ic + its_mc * MR * th_id);

        pack(orderA, transA, min(its_mc * MR, mc - its_mc * MR * th_id), kc, 
             Aptr, ldA, Ac + kc * its_mc * MR * th_id, MR);

        Ablk = Ac;

	for (jr=jr_init; jr<jr_limit; jr+=NR) {
          nr = min(nc-jr, NR); 
          for (ir=ir_init; ir<ir_limit; ir+=MR ) {
            mr = min(mc-ir, MR); 

	    if ( orderC=='C' ) Cptr = &Ccol(ic+ir,jc+jr);
	    else               Cptr = &Crow(ic+ir,jc+jr);

	    UKERNEL(mr, nr, kc, &Ablk[ir * kc], &Bc[jr * kc], Cptr, betaI, ldA, ldB, ldC);

          }
        }

        #pragma omp barrier

      }
    }
  }
  }
}

