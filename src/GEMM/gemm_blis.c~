// Pack B VMADOT (Riscv1.0). Multiply a Tile of Matrix of (4 x 4 x 8)
void pack_vmadot_Ccol_B(char orderM, char transM, int kc, int nc, IN_TYPE *M, int ldM, PACK_TYPE *Mc, int NR) {
  int    i, ii, j, jj, k, nr, kr;
  
  //WARNING: Packing for K1 with vlen=256. With int8|uint8_t we can store KR=32. 
  //Adjust KR for other vlen (i.e. for vlen=128, you must set KR=16).
  int KR = 8; 
  
  if ( orderM=='C') { //Order by columns
    for ( j=0; j < nc; j+=NR ) { //Packing NR x KR
      nr = min( nc-j, NR ); 
      for ( i=0; i < kc; i+=KR ) {
        kr = min( kc - i, KR );
        for ( jj=0; jj < nr; jj++ ) {
