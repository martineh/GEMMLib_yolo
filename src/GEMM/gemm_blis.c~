void pack_6x16_fp16_A( char orderM, char transM, int mc, int kc, IN_TYPE *M, int ldM, PACK_TYPE *Mc, int RR ){
  int  i, j, ii, k, rr;
  int kc_left = kc % 4;

  //MR=6
  k=0;
  for ( i=0; i<mc; i+=RR ) { 
    //k = i*kc;
    rr = min( mc-i, RR );

    for ( j=0; j<kc-3; j+=4 ) {
      for ( ii=0; ii<rr; ii++ ) {
	Mc[k] = (PACK_TYPE)Mcol(i+ii, j+0); k++;
	Mc[k] = (PACK_TYPE)Mcol(i+ii, j+1); k++;
	Mc[k] = (PACK_TYPE)Mcol(i+ii, j+2); k++;
	Mc[k] = (PACK_TYPE)Mcol(i+ii, j+3); k++;
      } 
      k += (RR-rr) * 4;
    }

    for (; j < kc; j++) {
      for ( ii=0; ii<rr; ii++ ) {
	Mc[k] = (PACK_TYPE)Mcol(i+ii, j); k++;
      } 
      k += (RR-rr) * 4;
    }

    k += (RR * kc_left);

  }

}


