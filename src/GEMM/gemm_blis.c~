            }
            for (jjj = 0; jjj < kc_4_padding; jjj++) {
              Mc[p] = 0; p++;
            }
          }
          for (jjj=0; jjj < nr * (KR - (kr_lim + kc_4_padding)); jjj++) {Mc[p] = 0; p++;}
