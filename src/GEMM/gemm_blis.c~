      for (j = 0; j < kc; j += KR) {
        kr_lim = min(KR, kc - j);
        for (jj =0 ; jj < kr_lim - 3; jj += 4) {
          for (ii =0 ; ii < nr; ii++) {
            Mc[p] = Mcol(j + jj + 0, i + ii); p++;
            Mc[p] = Mcol(j + jj + 1, i + ii); p++;
            Mc[p] = Mcol(j + jj + 2, i + ii); p++;
